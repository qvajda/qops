# RENDERED BY `qops install` from qops/templates/guard.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
#
# The server-side half of the guard. The PreToolUse hook is a local
# convenience an agent can disable; this one cannot be.
name: guard

on:
  push:
    branches: ['{{default_branch}}']
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  tripwires:
    runs-on: {{runs_on}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{python_version}}'
          cache: pip
      - name: install
        # NOT just pyyaml. Both jobs below `import qops`, and in a repo that
        # consumes qops as a dependency the package arrives through the
        # requirements file - nowhere else. This step used to be enough only
        # because the first repo to render it kept `qops/` as a subdirectory,
        # where `python -m qops` resolves from the working directory (#21).
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt
          else pip install pyyaml; fi
      - name: project tripwires
        # The list is .qops/config.yml's `tripwires:`, shared with the local
        # PreToolUse hook. Naming them here would put one project's constraints
        # in the substrate's template; a repo declaring none passes.
        run: python -m qops guard scan

  doc-links:
    runs-on: {{runs_on}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{python_version}}'
          cache: pip
      - name: install
        # NOT just pyyaml. Both jobs below `import qops`, and in a repo that
        # consumes qops as a dependency the package arrives through the
        # requirements file - nowhere else. This step used to be enough only
        # because the first repo to render it kept `qops/` as a subdirectory,
        # where `python -m qops` resolves from the working directory (#21).
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt
          else pip install pyyaml; fi
      - name: every docs/ path cited from code resolves
        # Archiving 89 docs broke 13 citations in Phase 3 and only a check
        # caught it. Without this the next archive pass breaks silently.
        run: |
          python - <<'PY'
          import sys
          from qops.install import broken_doc_links
          missing = broken_doc_links('.')
          for m in missing:
              print(f'::error::broken doc citation: {m}')
          sys.exit(1 if missing else 0)
          PY
