# RENDERED BY `qops install` from qops/templates/digest.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
#
# NO LLM RUNS HERE. The digest is a rendering of state that already exists —
# open issues, CI status, pending approvals. Anything needing judgement belongs
# in a session, not in a cron.
name: digest

on:
  schedule:
    - cron: '{{digest_cron}}'
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # #150. `advance` (automerge.yml) fires on the `closed` pull-request event,
  # and GitHub raises no such event for a merge its own GITHUB_TOKEN caused —
  # so the only path that matters, the unattended one, advanced nothing. This
  # job reads state instead of reacting to an event, which is why it repairs
  # the row however the PR merged: bot, human or hand-merge.
  #
  # It runs on {{digest_cron}} rather than on a third cadence of its own,
  # because the digest below is what consumes the result. `advance` stays as
  # the fast path; running both is a no-op by design.
  reconcile:
    runs-on: {{runs_on}}
    permissions:
      issues: write
      pull-requests: read
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{python_version}}'
          cache: pip
      - name: install
        # One block for every rendered job that runs Python, rendered from
        # `qops/install.py:INSTALL_DEPS` (ADR-0024). Three copies of it drifted
        # into three separate failures in repos shaped unlike this one.
        run: |
          {{install_deps}}
      - name: every merged sortie's row reaches state:done
        run: python -m qops reconcile

  digest:
    # The digest renders the rows the job above just repaired.
    needs: reconcile
    # Criterion 7 of the extraction PRD: owner CI attention must not double.
    # With two repos on one cadence it did. A project sets
    # `ci.digest_posts_on_schedule: false` to keep the RECONCILER daily - which
    # is the load-bearing half, since `advance` cannot fire on a merge its own
    # GITHUB_TOKEN caused - while the digest itself becomes on-demand.
    #
    # `success() &&` is not decoration: adding an `if:` drops the implicit
    # success() that `needs:` would otherwise imply, and a digest rendered from
    # rows a failed reconcile did not repair is worse than no digest.
    if: success() && ({{digest_posts_on_schedule}} || github.event_name == 'workflow_dispatch')
    runs-on: {{runs_on}}
    permissions:
      issues: write
      actions: read
      checks: read
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      REPO: {{repo}}
    steps:
      - name: render
        run: |
          {
            echo "*{{project}} — $(date -u '+%Y-%m-%d')*"
            echo
            echo "Open sorties:"
            gh issue list --repo "$REPO" --state open --limit 15 \
              --json number,title,labels \
              --template '{{ range . }}- #{{ .number }} {{ .title }}{{ "\n" }}{{ end }}'
            echo
            # The pickup-loop cannot request a review: GitHub rejects a
            # self-review request and this repo has one collaborator. A sortie
            # that wants the owner's eyes sets `state:review` instead, and this
            # is where that lands (owner decision 2026-08-18, #151).
            echo "Waiting on you (state:review):"
            gh issue list --repo "$REPO" --state open --limit 20 \
              --label state:review --json number,title \
              --template '{{ range . }}- #{{ .number }} {{ .title }}{{ "\n" }}{{ end }}'
            echo
            echo "Awaiting the owner:"
            gh pr list --repo "$REPO" --state open --limit 10 \
              --json number,title,reviewDecision \
              --template '{{ range . }}- PR #{{ .number }} {{ .title }} ({{ .reviewDecision }}){{ "\n" }}{{ end }}'
            echo
            # triage-loop's findings land here rather than in an Actions log
            # nobody opens: a warning with no reader has no terminal state.
            echo "Needs triage (no state: label):"
            gh issue list --repo "$REPO" --state open --limit 50 \
              --json number,title,labels \
              --jq '[.[] | select([.labels[].name] | map(startswith("state:")) | any | not)] | .[] | "- #\(.number) \(.title)"'
            echo
            echo "Last runs:"
            gh run list --repo "$REPO" --limit 5 \
              --json workflowName,conclusion,headBranch \
              --template '{{ range . }}- {{ .workflowName }} {{ .conclusion }} ({{ .headBranch }}){{ "\n" }}{{ end }}'
          } > digest.md
          cat digest.md

      - name: post to the dev Telegram bot
        if: env.TELEGRAM_TOKEN != ''
        env:
          TELEGRAM_TOKEN: ${{ secrets.QOPS_TELEGRAM_DEV_TOKEN }}
          TELEGRAM_CHAT: ${{ secrets.QOPS_TELEGRAM_DEV_CHAT_ID }}
        run: |
          curl -sS -X POST "https://api.telegram.org/bot$TELEGRAM_TOKEN/sendMessage" \
            --data-urlencode "chat_id=$TELEGRAM_CHAT" \
            --data-urlencode "parse_mode=Markdown" \
            --data-urlencode "text@digest.md" > /dev/null

      - name: update the pinned status issue
        run: |
          n=$(gh issue list --repo "$REPO" --label '{{status_issue_label}}' \
                --state open --limit 1 --json number --jq '.[0].number')
          if [ -z "$n" ] || [ "$n" = "null" ]; then
            gh issue create --repo "$REPO" --title 'qops status' \
              --label '{{status_issue_label}}' --body-file digest.md
          else
            gh issue edit "$n" --repo "$REPO" --body-file digest.md
          fi
