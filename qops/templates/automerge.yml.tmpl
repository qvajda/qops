# RENDERED BY `qops install` from qops/templates/automerge.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
#
# ADR-0020. A green `gate:machine` PR merges itself: the gate has already
# judged it, so the click was a mindless approval button, and a mindless
# approval button is not a control.
#
# This workflow does NOT merge — *provided the default branch has required
# status checks.* It queues GitHub's native auto-merge, which then waits for
# them. The workflow is the control — it fires without anyone remembering — and
# the gate stays the thing that decides.
#
# That proviso used to be an assumption and is now enforced, because it was
# false once and nothing said so: with no required checks a PR is mergeable the
# instant it opens, and the old `gh pr merge --auto` merged it on the spot.
# See the `enable` step below.
#
# The gate is read from the LINKED ISSUE, not from the PR. Issues are the
# source of truth (CLAUDE.md) and nothing labels a PR: the first cut read
# `github.event.pull_request.labels` and was structurally incapable of ever
# firing. The issue number comes from the branch, per ADR-0019 — the same rule
# `qops brief` uses.
#
# #128 added the other half: a merge released nothing, so a shipped sortie sat
# at `state:building` with `ready:auto` still on it forever. The `advance` job
# below closes that leak on the merge side, where it cannot depend on the
# launched agent having remembered to write anything.
name: automerge

on:
  pull_request:
    types: [opened, reopened, synchronize, labeled, unlabeled, ready_for_review,
            closed]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  enable:
    # Two conditions can be settled without an API call:
    #   draft — a draft is not a claim that the work is done
    #   fork  — an outside contributor's PR is a taste decision, and a fork
    #           token cannot be trusted with this repo's merges
    #   closed — `closed` is here for `advance`; there is nothing left to
    #           auto-merge on a PR that is already gone
    if: >-
      github.event.action != 'closed'
      && github.event.pull_request.draft == false
      && github.event.pull_request.head.repo.full_name == github.repository
    runs-on: {{runs_on}}
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: the linked issue authorises an unread merge
        id: check
        # REF is an environment variable, never interpolated into the script:
        # a branch name is attacker-controlled on a public repo.
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REF: ${{ github.event.pull_request.head.ref }}
        run: |
          stop() { echo "::notice::$1 - not auto-merging"
                   echo "ok=false" >> "$GITHUB_OUTPUT"; exit 0; }
          n=$(printf '%s' "$REF" | sed -nE 's|^[a-z]+/([0-9]+)-.*|\1|p')
          # No number includes `no-issue/`, which by definition has no gate.
          [ -n "$n" ] || stop "branch carries no issue number"
          labels=$(gh issue view "$n" --repo {{repo}} --json labels \
                     -q '.labels[].name' || true)
          case "$labels" in *no-auto*) stop "issue #$n carries no-auto" ;; esac
          case "$labels" in
            *gate:machine*) echo "ok=true" >> "$GITHUB_OUTPUT" ;;
            *)
              # #151. The sortie cannot request a GitHub review - GitHub
              # rejects a self-review request and this repo has one
              # collaborator - so the waiting-on-you signal is a label, and
              # digest.yml renders it. Set here rather than asked of the
              # launched agent: an instruction in a prompt is a preference,
              # not a control (GL-53).
              #
              # #5. `--remove-label state:building` failed the whole call
              # whenever the issue carried a different `state:`, and `|| true`
              # swallowed that failure - the add never ran, and nothing said
              # so. Remove whichever `state:` label the issue actually
              # carries, same as `advance` does below, and fail loudly if the
              # edit still fails instead of hiding it.
              gh issue edit "$n" --repo {{repo}} --add-label state:review \
                --remove-label state:triage --remove-label state:planned \
                --remove-label state:building --remove-label state:gate \
                --remove-label state:blocked \
                || echo "::error::could not label issue #$n state:review - see the gh error above"
              stop "issue #$n is not gate:machine - the owner merges this one" ;;
          esac

      - name: hand the merge to the required checks
        if: steps.check.outputs.ok == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR: ${{ github.event.pull_request.number }}
          PR_ID: ${{ github.event.pull_request.node_id }}
        # `gh pr merge --auto` hides the difference between *queued* and
        # *merged right now*. With no required status checks on the default
        # branch a PR is mergeable the instant it opens, so `--auto` merges it
        # unread - this job's own header says it does not merge, and it did.
        # Observed on qvajda/qops #2: merged ten seconds before its own gate
        # finished, in a repo whose branch protection was not yet configured.
        #
        # `enablePullRequestAutoMerge` does not hide it. It FAILS when there is
        # nothing to queue behind, and that failure is exactly the signal that
        # no check is gating this branch. Fail closed, and name the cause.
        run: |
          out=$(gh api graphql -f query='
            mutation($pr: ID!) {
              enablePullRequestAutoMerge(input: {
                pullRequestId: $pr, mergeMethod: SQUASH
              }) { clientMutationId }
            }' -F pr="$PR_ID" 2>&1) && rc=0 || rc=$?
          case "$out" in
            *"already enabled"*|*"Auto merge is already"*)
              echo "::notice::auto-merge already queued on #$PR"; exit 0 ;;
          esac
          if [ "$rc" = 0 ]; then
            echo "::notice::auto-merge queued on #$PR - the required checks merge it"
            exit 0
          fi
          echo "$out"
          echo "::error::could not queue auto-merge on #$PR. The usual cause is that {{default_branch}} has no required status checks: the PR is already mergeable, there is nothing to queue behind, and enabling it would merge unread code. Configure branch protection (ADR-0016) - the checks are what merge, not this job."
          exit 1

  advance:
    # #128. A merged PR means the code landed, so the sortie's issue reaches a
    # terminal state and stops carrying `ready:auto` — the claim `pickup-loop`
    # took is released on success, not only on failure.
    #
    # It always labels. On `gate:taste` it stops there: a merge is not a
    # judgement, and the owner's read is the only judgement there is - closing
    # stays theirs. On `gate:machine` it also closes (ADR-0025): the gate
    # already judged this row the same way it judged the merge, so there is no
    # taste read left to give and no owner action to wait on.
    #
    # Unconditional label step, on the gate: whoever merged it, by hand or by
    # the job above, the code is on {{default_branch}} and the row is not in
    # flight.
    if: >-
      github.event.action == 'closed'
      && github.event.pull_request.merged == true
    runs-on: {{runs_on}}
    permissions:
      issues: write
    steps:
      - name: the merged sortie reaches a terminal state
        # REF is an environment variable for the same reason it is above.
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REF: ${{ github.event.pull_request.head.ref }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          n=$(printf '%s' "$REF" | sed -nE 's|^[a-z]+/([0-9]+)-.*|\1|p')
          # `no-issue/` branches carry no sortie and have nothing to advance.
          [ -n "$n" ] || { echo "::notice::branch carries no issue number"; exit 0; }
          # Removing a label the issue does not carry is a no-op, so the whole
          # state: family goes in one call rather than a read-then-write.
          gh issue edit "$n" --repo {{repo}} \
            --add-label state:done \
            --remove-label ready:auto \
            --remove-label state:triage --remove-label state:planned \
            --remove-label state:building --remove-label state:gate \
            --remove-label state:review --remove-label state:blocked
          labels=$(gh issue view "$n" --repo {{repo}} --json labels -q '.labels[].name')
          case "$labels" in
            *gate:machine*)
              case "$labels" in
                *no-auto*) echo "::notice::#$n carries no-auto - not closing" ;;
                *) gh issue close "$n" --repo {{repo}} --comment \
                     "Closed by \`automerge-loop\`: \`gate:machine\`, PR #$PR merged - nothing left to judge (ADR-0025)." ;;
              esac ;;
          esac
