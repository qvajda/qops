# RENDERED BY `qops install` from qops/templates/test.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
name: test

on:
  # Branch pushes are covered by the PR run. Without this the same commit is
  # tested twice and a PR costs twice the wall clock it needs to.
  push:
    branches: ['{{default_branch}}']
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    runs-on: {{runs_on}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{python_version}}'
          cache: pip
      - name: install
        # One block for every rendered job that runs Python, rendered from
        # `qops/install.py:INSTALL_DEPS` (ADR-0024). Three copies of it drifted
        # into three separate failures in repos shaped unlike this one.
        run: |
          {{install_deps}}
      - name: {{test_command}}
        run: {{test_command}}
