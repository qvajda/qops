# RENDERED BY `qops install` from qops/templates/test.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
name: test

on:
  # Branch pushes are covered by the PR run. Without this the same commit is
  # tested twice and a PR costs twice the wall clock it needs to.
  push:
    branches: ['{{default_branch}}']
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    runs-on: {{runs_on}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{python_version}}'
          cache: pip
      - name: install
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi
      - name: {{test_command}}
        run: {{test_command}}
