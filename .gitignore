.qops/ledger.jsonl
.qops/outbox.jsonl
.qops/state-report.md
.qops/wt/

# Per-machine Claude settings. settings.json is tracked; the .local one holds
# absolute paths and is a machine fact.
.claude/settings.local.json
.claude/worktrees/
